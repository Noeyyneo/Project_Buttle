        {"name":"R4.2 Cannot view another user's booking","event":[{"listen":"test","script":{"exec":["pm.test('protects booking ownership', () => pm.response.to.have.status(403));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":"{{baseUrl}}/bookings/{{maxThreeBookingId}}"}}
