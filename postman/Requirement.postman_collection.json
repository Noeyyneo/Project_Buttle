        {"name":"R5.2 Reject status edits through booking update","event":[{"listen":"test","script":{"exec":["pm.test('reserves status updates for check-in/status endpoints', () => pm.response.to.have.status(400));"]}}],"request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{maxThreeToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"cancelled\"}"},"url":"{{baseUrl}}/bookings/{{maxThreeBookingId}}"}},
        {"name":"R5.3 Cannot edit another user's booking","event":[{"listen":"test","script":{"exec":["pm.test('protects booking ownership', () => pm.response.to.have.status(403));"]}}],"request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{userToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"sessionId\":\"{{maxThreeSessionId}}\"}"},"url":"{{baseUrl}}/bookings/{{maxThreeBookingId}}"}}
      ]
