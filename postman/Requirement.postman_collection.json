    {
      "name":"AR2 - Administrator approves or rejects representatives",
      "item":[
        {"name":"AR2.1 Admin lists representatives and approval status","event":[{"listen":"test","script":{"exec":["pm.test('admin lists representative accounts', () => pm.response.to.have.status(200));", "pm.test('representatives include approvalStatus and company', () => { const r=pm.response.json().data[0]; pm.expect(r).to.have.property('approvalStatus'); pm.expect(r).to.have.property('companyId'); });", "pm.collectionVariables.set('alphaRepresentativeId', pm.response.json().data[0]._id);"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/representatives"}},
