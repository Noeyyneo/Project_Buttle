  "item": [
    {
      "name": "00 - Test setup (run first)",
      "item": [
        { "name": "Create unique run ID", "event": [{ "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('runId', Date.now().toString());"] }}], "request": { "method": "GET", "url": "{{baseUrl}}/companies" } },
        { "name": "Login - System Admin (administrator account)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] }}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"admin@buttle.test\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Login - New Candidate (registered user, no bookings)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('user login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('userToken', pm.response.json().token);"] }}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"newcandidate@buttle.test\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Login - Max Three Candidate (registered user, 3 active bookings)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('max-three user login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('maxThreeToken', pm.response.json().token);"] }}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"maxthree@buttle.test\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Login - Alpha Representative (approved account)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('approved representative login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('alphaRepToken', pm.response.json().token);"] }}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"rep.alpha@buttle.test\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Login - Bright Representative (approved account)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('second representative login succeeds', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('brightRepToken', pm.response.json().token);"] }}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"rep.bright@buttle.test\",\n  \"password\": \"{{password}}\"\n}"}, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Discover Alpha company and session IDs", "event": [{ "listen": "test", "script": { "exec": ["pm.test('Alpha sessions are available', () => pm.response.to.have.status(200));", "const sessions=pm.response.json().data; pm.expect(sessions.length).to.be.above(1); pm.collectionVariables.set('alphaSessionId', sessions[0]._id); pm.collectionVariables.set('alphaSessionTwoId', sessions[1]._id); pm.collectionVariables.set('alphaCompanyId', sessions[0].companyId._id || sessions[0].companyId);"] }}], "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{alphaRepToken}}"}], "url": "{{baseUrl}}/interviewSessions" } },
        { "name": "Discover Bright company, session, and booking IDs", "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bright bookings are available', () => pm.response.to.have.status(200));", "const bookings=pm.response.json().data; pm.expect(bookings.length).to.be.above(0); const b=bookings[0]; const s=b.sessionId; pm.collectionVariables.set('brightBookingId', b._id); pm.collectionVariables.set('brightSessionId', s._id || s); pm.collectionVariables.set('brightCompanyId', (s.companyId && (s.companyId._id || s.companyId)) || '');"] }}], "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{brightRepToken}}"}], "url": "{{baseUrl}}/bookings" } },
        { "name": "Discover candidate booking IDs", "event": [{ "listen": "test", "script": { "exec": ["pm.test('candidate bookings are available', () => pm.response.to.have.status(200));", "const bookings=pm.response.json().data; pm.expect(bookings.length).to.be.above(0); const b=bookings[0]; pm.collectionVariables.set('maxThreeBookingId', b._id); pm.collectionVariables.set('maxThreeSessionId', b.sessionId._id || b.sessionId);"] }}], "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{maxThreeToken}}"}], "url": "{{baseUrl}}/bookings" } }
      ]
    },
    {
      "name": "R1 - User registration",
      "item": [
        { "name": "R1.1 Register user with all required fields", "event": [{"listen":"test","script":{"exec":["pm.test('creates the registered user', () => pm.response.to.have.status(201));", "pm.test('returns a JWT', () => pm.expect(pm.response.json().token).to.be.a('string');"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Demo User {{runId}}\",\n  \"telephone\": \"0891112222\",\n  \"email\": \"demo.user.{{runId}}@buttle.test\",\n  \"password\": \"Password123!\"\n}"},"url":"{{baseUrl}}/auth/register"} },
        { "name": "R1.2 Reject registration missing telephone", "event":[{"listen":"test","script":{"exec":["pm.test('validates required registration fields', () => pm.response.to.have.status(400));"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Missing Field\",\n  \"email\": \"missing.{{runId}}@buttle.test\",\n  \"password\": \"Password123!\"\n}"},"url":"{{baseUrl}}/auth/register"} }
      ]
    },
    {
      "name": "R2 - Login, authenticated access, logout",
      "item": [
        { "name":"R2.1 Reject invalid credentials", "event":[{"listen":"test","script":{"exec":["pm.test('does not authenticate invalid credentials', () => pm.response.to.have.status(401));"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"newcandidate@buttle.test\",\"password\":\"wrong-password\"}"},"url":"{{baseUrl}}/auth/login"} },
        { "name":"R2.2 Read current authenticated user", "event":[{"listen":"test","script":{"exec":["pm.test('returns authenticated user', () => pm.response.to.have.status(200));"]}}], "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":"{{baseUrl}}/auth/me"} },
        { "name":"R2.3 Reject protected route without token", "event":[{"listen":"test","script":{"exec":["pm.test('requires authentication', () => pm.response.to.have.status(401));"]}}], "request":{"method":"GET","url":"{{baseUrl}}/auth/me"} },
        { "name":"R2.4 Logout invalidates the active token", "event":[{"listen":"test","script":{"exec":["pm.test('logout succeeds', () => pm.response.to.have.status(200));"]}}], "request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":"{{baseUrl}}/auth/logout"} },
        { "name":"R2.5 Re-login for remaining folders", "event":[{"listen":"test","script":{"exec":["pm.test('can log in again after logout', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('userToken', pm.response.json().token);"]}}], "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"newcandidate@buttle.test\",\"password\":\"{{password}}\"}"},"url":"{{baseUrl}}/auth/login"} }
      ]
    },
    {
      "name":"R3 - Book up to 3 sessions and view companies",
      "item":[
        {"name":"R3.1 List companies with required company information","event":[{"listen":"test","script":{"exec":["pm.test('lists companies', () => pm.response.to.have.status(200));", "pm.test('company exposes required fields', () => { const c=pm.response.json().data[0]; ['name','address','website','description','telephone'].forEach(k=>pm.expect(c).to.have.property(k)); });"]}}],"request":{"method":"GET","url":"{{baseUrl}}/companies"}},
        {"name":"R3.2 List available interview sessions","event":[{"listen":"test","script":{"exec":["pm.test('lists sessions', () => pm.response.to.have.status(200));"]}}],"request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":"{{baseUrl}}/interviewSessions"}},
        {"name":"R3.3 Reject a fourth active booking","event":[{"listen":"test","script":{"exec":["pm.test('enforces the maximum of three bookings', () => pm.response.to.have.status(400));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{maxThreeToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"sessionId\":\"{{brightSessionId}}\"}"},"url":"{{baseUrl}}/bookings"}},
        {"name":"R3.4 Reject duplicate booking for the same session","event":[{"listen":"test","script":{"exec":["pm.test('rejects a duplicate booking', () => pm.response.to.have.status(400));"]}}],"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{maxThreeToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"sessionId\":\"{{maxThreeSessionId}}\"}"},"url":"{{baseUrl}}/bookings"}}
      ]
