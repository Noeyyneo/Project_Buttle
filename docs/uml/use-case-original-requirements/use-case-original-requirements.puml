@startuml
title Online Job Fair Registration System\nUse Case Diagram - Original Requirements Only (O1-O9)
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  ArrowColor #475569
}
skinparam actor {
  BorderColor #1D4ED8
  FontColor #0F172A
}

actor Guest
actor "Registered User" as User
actor Administrator as Admin

rectangle "Online Job Fair Registration System" {
  usecase "Register account" as UC_Register
  usecase "Log in" as UC_Login
  usecase "Log out" as UC_Logout
  usecase "View company list and information" as UC_Companies
  usecase "Create interview booking" as UC_Create
  usecase "Select preferred company\nand interview date" as UC_Select
  usecase "View own bookings" as UC_ViewOwn
  usecase "Edit own booking" as UC_EditOwn
  usecase "Cancel own booking" as UC_CancelOwn
  usecase "View all bookings" as UC_ViewAll
  usecase "Edit any booking" as UC_EditAny
  usecase "Delete any booking" as UC_DeleteAny
  usecase "Authenticate user" as UC_Auth
  usecase "Validate booking rules" as UC_Validate
}

Guest --> UC_Register
Guest --> UC_Login

User --> UC_Logout
User --> UC_Companies
User --> UC_Create
User --> UC_ViewOwn
User --> UC_EditOwn
User --> UC_CancelOwn

Admin --> UC_Logout
Admin --> UC_ViewAll
Admin --> UC_EditAny
Admin --> UC_DeleteAny

UC_Companies .> UC_Auth : <<include>>
UC_Create .> UC_Auth : <<include>>
UC_ViewOwn .> UC_Auth : <<include>>
UC_EditOwn .> UC_Auth : <<include>>
UC_CancelOwn .> UC_Auth : <<include>>
UC_ViewAll .> UC_Auth : <<include>>
UC_EditAny .> UC_Auth : <<include>>
UC_DeleteAny .> UC_Auth : <<include>>
UC_Create .> UC_Validate : <<include>>
UC_Create .> UC_Select : <<include>>
UC_EditOwn .> UC_Validate : <<include>>
UC_EditAny .> UC_Validate : <<include>>

note bottom of UC_Validate
  Original booking constraints:
  * session is during 10-13 May 2022
  * a user has at most 3 bookings
end note

note bottom of UC_Companies
  Company information: name, address,
  website, description, and telephone number.
end note

legend right
  |= ID |= Requirement |
  | O1 | Register account |
  | O2 | Login / logout |
  | O3 | View companies and book up to 3 sessions |
  | O4-O6 | User manages own bookings |
  | O7-O9 | Admin manages all bookings |
endlegend
@enduml
