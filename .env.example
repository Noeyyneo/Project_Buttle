# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string. Replace with your own private value in .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/project_buttle?retryWrites=true&w=majority

# Generate a private value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the generated value.
JWT_SECRET=replace-with-a-long-random-secret
